# --- Tractive účet (jen e-mail + heslo; Apple/Google sign-in nefunguje) ---
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=change-me

# --- Databáze (Postgres s PostGIS). Supabase: Project Settings -> Database -> Connection string.
# Pro dlouho běžící proces použij "Session pooler" (port 5432) nebo direct connection, ne transaction pooler (6543).
# Prázdné = běh bez DB (eventy se jen logují / zapisují do FIXTURES_DIR).
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Chování ingestoru ---
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
# Kolik dní historie dotáhnout, když v DB pro tracker ještě nic není
BACKFILL_DAYS=7
# Velikost jednoho okna požadavku na historii (hodiny)
BACKFILL_CHUNK_HOURS=24
# Jak často stahovat health overview (s)
HEALTH_POLL_INTERVAL_S=3600
# Exponenciální backoff reconnectu kanálu (s)
RECONNECT_BACKOFF_BASE_S=5
RECONNECT_BACKOFF_MAX_S=300
# Tvrdý reconnect, pokud z kanálu nepřišel žádný event N sekund (0 = vypnuto).
# 60s keep-alive watchdog řeší přímo aiotractive.
CHANNEL_MAX_SILENCE_S=0
# --- Health server (/healthz = liveness, /readyz = readiness) ---
# 127.0.0.1 = jen lokálně (systemd/venv). V Dockeru se přepíše na 0.0.0.0 (Dockerfile/compose).
# HEALTH_PORT=0 server vypne.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# /readyz vrací 503, pokud z kanálu nepřišel event/keep-alive déle než N s
HEALTH_READY_MAX_AGE_S=90
# --- Fronta povelů (LIVE/buzzer/LED; zařazení: `python -m tractive_ingestor enqueue <tracker_id> live on`) ---
# Jak často worker kouká do tabulky commands (s) – jen lokální DB, ne Tractive API
COMMAND_POLL_INTERVAL_S=4
# Doma (power-saving / KNOWN_WIFI) povely neprojdou: odkládat max. N s od zařazení, pak failed
COMMAND_DEFER_TIMEOUT_S=600
# Rozestup opakování odloženého povelu (s); po chybě API lineární backoff (N × pokus)
COMMAND_DEFER_RETRY_S=30
# Max. skutečných volání API na jeden povel
COMMAND_MAX_ATTEMPTS=3
# Odeslaný povel bez potvrzení ze streamu se po N s uzavře jako done (last_error=unconfirmed)
COMMAND_CONFIRM_TIMEOUT_S=120
# Fáze 0: sem se zapisují raw payloady jako JSONL fixtures (prázdné = vypnuto)
FIXTURES_DIR=./fixtures
# Časová zóna pro výpočet "dne" v health_daily
LOCAL_TZ=Europe/Prague

# --- Docker Compose (docker-compose.yml) ---
# Lokální Postgres/PostGIS ve službě `db`. Ingestor v compose dostane DATABASE_URL
# složené z těchto hodnot (DATABASE_URL výše se v compose přepíše).
# Heslo bez znaků @ : / ? # (skládá se do URL).
POSTGRES_USER=tractive
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=tractive
# Publikace health portu na hostu (docker-compose). Default jen loopback Pi;
# pro monitoring přes Tailscale dej Tailscale IP Pi (`tailscale ip -4`).
# HEALTH_PUBLISH_ADDR=100.x.y.z
# HEALTH_PUBLISH_PORT=8080
# --- API + PWA (služba `api`, src/tractive_api, web/) ---
# Publikace portu appky na hostu. Default jen loopback Pi; telefon přes Tailscale → Tailscale IP Pi
# (`tailscale ip -4`), např. API_PUBLISH_ADDR=100.x.y.z → http://100.x.y.z:8090/
# NIKDY 0.0.0.0 – API zatím nemá autentizaci (ochranu dělá jen Tailscale).
# API_PUBLISH_ADDR=100.x.y.z
# API_PUBLISH_PORT=8090
# CORS – jen pro vývoj PWA (`npm run dev` na :5173); same-origin PWA ho nepotřebuje
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pool spojení API do DB (API jen čte + vkládá povely)
# API_DB_POOL_MAX=3
# Build-time base URL API pro PWA; prázdné = same-origin "/api" (doporučeno)
# VITE_API_BASE=
# Mimo Docker (python -m tractive_api): kde poslouchat a kde je build PWA
# API_HOST=127.0.0.1
# API_PORT=8090
# API_WEB_DIST=web/dist
# Strop bodů na /positions a default okno (h)
# API_POSITIONS_MAX_LIMIT=5000
# API_POSITIONS_DEFAULT_HOURS=24
# Supabase místo lokální DB: vyplň a spouštěj `docker compose up -d --no-deps ingestor`
# INGESTOR_DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# --- Geofence doma / venku (ingestor i API; v compose se API předá z tohoto .env) ---
# CITLIVÉ: souřadnice domova patří JEN do .env (je v .gitignore). Nevyplněné = funkce vypnutá.
# HOME_LAT=
# HOME_LON=
# Poloměr domácí zóny (m)
# HOME_RADIUS_M=80
# Debounce: přepnout na "venku" až po N s nepřetržitě venku, na "doma" po N s uvnitř
# GEOFENCE_DEBOUNCE_LEAVE_S=120
# GEOFENCE_DEBOUNCE_RETURN_S=60
# GPS fix s horší přesností (m) se pro geofence ignoruje
# GEOFENCE_MAX_ACCURACY_M=150
# Venku a dál než N m -> v appce "Utekla!"
# GEOFENCE_ESCAPE_M=300
# Bod v domácí WiFi / power-saving zóně (Tractive) potvrdí návrat hned, bez debounce
# GEOFENCE_TRUST_TRACTIVE_HOME=true
# Jak často ingestor vyhodnocuje (s); 0 = jen při dotazu z appky
# GEOFENCE_EVAL_INTERVAL_S=30
# --- Web Push upozornění (ingestor posílá, API spravuje odběry) ---
# Klíče vygeneruj:  docker compose run --rm --no-deps ingestor gen-vapid   (nebo python -m tractive_ingestor gen-vapid)
# CITLIVÉ (privátní klíč) – jen do .env. Nevyplněné = upozornění vypnutá.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# docker-compose.yml uses mailto:you@example.com when this is unset. Set a real mailto here
# before deploying, so the Web Push contact claim is yours.
# Jak často ingestor kontroluje nové události / baterii (s); 0 = vypnuto
# PUSH_EVAL_INTERVAL_S=30
# --- Přihlášení do appky (API) ---
# Heslo/fráze (dlouhá!). Prázdné = API bez přihlášení (jen lokální vývoj).
# APP_PIN=
# Klíč pro podpis session cookie:  openssl rand -hex 32
# APP_SESSION_SECRET=
# --- Passkeys (Face ID / Touch ID) ---
# RP ID = doména appky (passkey funguje JEN na ní), origin = přesná adresa (víc čárkami)
# Default localhost / http://localhost:8090 (jen vývoj). V produkci nastav svou doménu:
# WEBAUTHN_RP_ID=maja.example.com
# WEBAUTHN_ORIGIN=https://maja.example.com
